# Aigoni 环境配置模板。


# 后台管理员密码（必填，弱口令会被拒绝）
ADMIN_PASSWORD=change-me
# 服务端口
PORT=8080
# 后台面板路径
ADMIN_PATH=admin

# Wiki LLM 配置
WIKI_APIKEY=
WIKI_BASEURL=https://api.example.com/v1
WIKI_MODEL=example-model


# --- 下列内容非二次开发人员保持默认即可 --- #

# Web/Admin 原生静态文件目录，留空使用内置UI。
WEB_FRONTEND_DIR=
ADMIN_FRONTEND_DIR=
# 后台上传限制
AIGONI_UPLOAD_ALLOWED_EXTS=jpg,jpeg,png,webp,gif
AIGONI_ADMIN_PER_PAGE=20
# HTTPS 部署时建议设为 true，会话 Cookie 会带上 Secure 标记；
# 本地 HTTP 开发保持 false（缺省值）。
COOKIE_SECURE=false

# 自动化 API Key：同时用于 /api/content 内容写入与 /api/admin/v1/wiki/ask:api 只读 Wiki Ask；
# 留空时相关机器接口拒绝所有请求。
AIGONI_API_KEY=
# 机器只读 Wiki Ask 接口开关：设为 true 才启用 POST /api/admin/v1/wiki/ask:api；
# 默认关闭，未开启时该接口拒绝所有请求。
AIGONI_WIKI_ASK_API_ENABLED=false
# 机器只读 Wiki Ask 提交接口的每分钟请求上限；正整数，默认 60。
AIGONI_WIKI_ASK_API_RPM=60
# Wiki Agent 总并发上限；Admin Wiki Chat 与机器只读 Wiki Ask 共用，正整数，默认 5。
AIGONI_WIKI_AGENT_CONCURRENCY=5
